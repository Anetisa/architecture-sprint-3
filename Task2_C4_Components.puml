
@startuml
!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

title Контейнер "Обработка платежей" для системы умного дома

Container_Boundary(PaymentProcessing, "Обработка платежей") {
    Component(APIHandler, "API Handler", "Обрабатывает входящие HTTP-запросы")
    Component(BusinessLogic, "Business Logic", "Основная логика обработки платежей")
    Component(KafkaConsumer, "Kafka Consumer", "Читает запросы на оплату из Kafka")
    Component(KafkaProducer, "Kafka Producer", "Публикует события оплаты в Kafka")
    Component(PaymentRepository, "Payment Repository", "Управляет доступом к данным о платежах")
    Component(PaymentGatewayClient, "Payment Gateway Client", "Интеграция с внешним платежным шлюзом")
    Component(NotificationClient, "Notification Client", "Отправляет уведомления о статусе платежа")
    ContainerDb(PaymentDB, "Payment Database", "Хранилище данных о платежах")
}

' Внешние системы
System_Ext(User, "Пользователь", "Инициирует оплату через мобильное приложение или веб-интерфейс")
System_Ext(ExternalPaymentGateway, "Внешний платежный шлюз", "Обрабатывает платежи")
System_Ext(NotificationService, "Сервис уведомлений", "Отправляет уведомления пользователю")
SystemQueue(PaymentRequests, "payment_requests", "Топик Kafka для запросов на оплату")
SystemQueue(PaymentEvents, "payment_events", "Топик Kafka для событий оплаты")

' Взаимодействия внутри контейнера
Rel(APIHandler, BusinessLogic, "Передает запросы на оплату")
Rel(KafkaConsumer, BusinessLogic, "Передает запросы из Kafka")
Rel(BusinessLogic, PaymentRepository, "Сохраняет/извлекает данные о платежах")
Rel(PaymentRepository, PaymentDB, "Сохраняет/извлекает данные")
Rel(BusinessLogic, PaymentGatewayClient, "Выполняет оплату через внешний шлюз")
Rel(BusinessLogic, KafkaProducer, "Публикует события оплаты")
Rel(BusinessLogic, NotificationClient, "Отправляет уведомления")

' Взаимодействия с внешними системами
Rel(User, APIHandler, "Отправляет запрос на оплату")
Rel(APIHandler, PaymentRequests, "Публикует запросы на оплату")
Rel(PaymentRequests, KafkaConsumer, "Читает запросы")
Rel(PaymentGatewayClient, ExternalPaymentGateway, "Выполняет платеж")
Rel(KafkaProducer, PaymentEvents, "Публикует события оплаты")
Rel(NotificationClient, NotificationService, "Отправляет уведомления")

@enduml

@startuml
!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

title Контейнер "Управление светом" для системы умного дома

Container_Boundary(LightControl, "Управление светом") {
    Component(APIHandler, "API Handler", "Обрабатывает входящие HTTP-запросы")
    Component(BusinessLogic, "Business Logic", "Основная логика управления светом")
    Component(KafkaConsumer, "Kafka Consumer", "Читает команды из Kafka")
    Component(KafkaProducer, "Kafka Producer", "Публикует события в Kafka")
    Component(DeviceController, "Device Controller", "Управляет устройствами (светом)")
    Component(NotificationClient, "Notification Client", "Отправляет уведомления о статусе света")
    ContainerDb(LightStateDB, "Light State Database", "Хранилище состояния света")
}

' Внешние системы
System_Ext(User, "Пользователь", "Инициирует команды через мобильное приложение или веб-интерфейс")
System_Ext(NotificationService, "Сервис уведомлений", "Отправляет уведомления пользователю")
SystemQueue(LightCommands, "light_commands", "Топик Kafka для команд управления светом")
SystemQueue(LightEvents, "light_events", "Топик Kafka для событий состояния света")

' Взаимодействия внутри контейнера
Rel(APIHandler, BusinessLogic, "Передает команды")
Rel(KafkaConsumer, BusinessLogic, "Передает команды из Kafka")
Rel(BusinessLogic, DeviceController, "Управляет устройствами")
Rel(BusinessLogic, KafkaProducer, "Публикует события состояния света")
Rel(BusinessLogic, NotificationClient, "Отправляет уведомления")
Rel(DeviceController, LightStateDB, "Сохраняет/извлекает состояние света")

' Взаимодействия с внешними системами
Rel(User, APIHandler, "Отправляет команды")
Rel(APIHandler, LightCommands, "Публикует команды")
Rel(LightCommands, KafkaConsumer, "Читает команды")
Rel(KafkaProducer, LightEvents, "Публикует события")
Rel(NotificationClient, NotificationService, "Отправляет уведомления")

@enduml
